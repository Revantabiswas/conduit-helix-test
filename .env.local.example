# Environment variables for the Next.js app (Story 1.1, REQ-F-04).
# Copy to .env.local and fill in real values. NEVER commit .env.local.
#
# Either provide a single connection URL:
# DATABASE_URL=postgres://user:password@localhost:5432/conduit
#
# ...or the discrete variables:
DB_USERNAME=
DB_PASSWORD=
DB_NAME=conduit
DB_HOSTNAME=localhost
DB_DIALECT=postgres
DB_LOGGING=false

# JWT signing secret (used by the auth layer in Story 1.2)
JWT_SECRET=

NODE_ENV=development
